(defcfg
  process-unmapped-keys yes
)

(defsrc
  a s d f j k l ;
)

(defvar
  tap-time 200
  hold-time 200
  
  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
)

(deflayer base
  @ca @cs @cd @f @cj @ck @cl @c;
)

(deflayer nomods
  a s d f j k l ;
)

(deffakekeys
  to-base (layer-switch base)
)

;; -- Left Hand Chords --
(defchords left-chords 100
  (a    ) @a
  (  s  ) @s
  (    d) @d
  
  (a s d) esc
)

;; -- Right Hand Chords --
(defchords right-chords 100
  ;; Changed these back to @j and @k
  (j      ) @j
  (  k    ) @k
  (    l  ) @l
  (      scl) @;
  
  (j k l  ) ret
  (  k l scl) bspc
)

(defalias
  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  ;; Left-hand mods
  a (tap-hold-release-keys $tap-time $hold-time (multi a @tap) lmet $left-hand-keys)
  s (tap-hold-release-keys $tap-time $hold-time (multi s @tap) lalt $left-hand-keys)
  d (tap-hold-release-keys $tap-time $hold-time (multi d @tap) lctl $left-hand-keys)
  f (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)

  ;; Right-hand mods (Brought j and k back!)
  j (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
  k (tap-hold-release-keys $tap-time $hold-time (multi k @tap) rctl $right-hand-keys)
  l (tap-hold-release-keys $tap-time $hold-time (multi l @tap) ralt $right-hand-keys)
  ; (tap-hold-release-keys $tap-time $hold-time (multi ; @tap) rmet $right-hand-keys)

  ;; Left Hand Chord Triggers
  ca (chord left-chords a)
  cs (chord left-chords s)
  cd (chord left-chords d)

  ;; Right Hand Chord Triggers
  cj (chord right-chords j)
  ck (chord right-chords k)
  cl (chord right-chords l)
  c; (chord right-chords scl)
)
