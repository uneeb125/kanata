(defcfg
  process-unmapped-keys yes
  ;; This allows multiple modifiers to be processed at the same time
  concurrent-tap-hold yes
)

(defsrc
  a s d f j k l ;
)

(defvar
  ;; tap-repress-timeout, then hold timeout
  tap-time 200
  hold-time 150

  ;; ONLY the non-mod letters of each hand.
  ;; The home-row mod keys themselves are deliberately excluded, so that
  ;; holding two of them still stacks instead of cancelling into taps.
  left-hand-letters (q w e r t g z x c v b)
  right-hand-letters (y u i o p h n m , . /)
)

(deflayer base
  @a @s @d @f @j @k @l @scl
)

(defalias
  ;; tap-hold-release-keys (same lists as before, only the variant changed):
  ;;   - a listed same-hand letter pressed      -> resolve TAP immediately
  ;;     (fast same-hand rolls, e.g. "as", "jk")
  ;;   - another key pressed AND released       -> resolve HOLD early
  ;;     (PermissiveHold) so a chord engages when the target key is released
  ;;     instead of always waiting the full hold timeout
  ;;   - nothing else happens                   -> HOLD at the hold timeout,
  ;;     which is what lets same-hand mods be held together and STACK
  ;; -- Left Hand Mods --
  a (tap-hold-release-keys $tap-time $hold-time a lmet $left-hand-letters)
  s (tap-hold-release-keys $tap-time $hold-time s lalt $left-hand-letters)
  d (tap-hold-release-keys $tap-time $hold-time d lctl $left-hand-letters)
  f (tap-hold-release-keys $tap-time $hold-time f lsft $left-hand-letters)

  ;; -- Right Hand Mods --
  j (tap-hold-release-keys $tap-time $hold-time j rsft $right-hand-letters)
  k (tap-hold-release-keys $tap-time $hold-time k rctl $right-hand-letters)
  l (tap-hold-release-keys $tap-time $hold-time l ralt $right-hand-letters)
  scl (tap-hold-release-keys $tap-time $hold-time ; rmet $right-hand-letters)
)
