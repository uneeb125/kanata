(defcfg
  process-unmapped-keys yes
  ;; This allows multiple modifiers to be processed at the same time
  concurrent-tap-hold yes

  ;; Only grab the keyboards actually used. This keeps the gamepad /
  ;; Bluetooth / other transient "keyboard" devices from being grabbed,
  ;; so their connect/disconnect churn cannot disturb input handling.
  linux-dev-names-include (
    "Pilot W-CORNE"
    "Pilot W-CORNE Consumer Control"
    "Pilot W-CORNE System Control"
    "foostan Corne v4 Keyboard"
  )

  ;; If none of the above are present at startup, wait for them rather
  ;; than exiting.
  linux-continue-if-no-devs-found yes
)

(defsrc
  a s d f j k l ;
)

(defvar
  tap-time 200
  hold-time 200
  
  ;; ONLY the letters (no modifiers) for same-hand roll protection
  left-hand-letters (q w e r t g z x c v b)
  right-hand-letters (y u i o p h n m , . /)
)

(deflayer base
  @a @s @d @f @j @k @l @scl
)

(defalias
  ;; -- Left Hand Mods --
  ;; Exclusion list only contains left-hand letters. 
  ;; This allows 'a' and 's' to be held together for stacking.
  ;; Right-hand keys are NOT in the list, providing the "Grace Period".
  a (tap-hold-except-keys $tap-time $hold-time a lmet $left-hand-letters)
  s (tap-hold-except-keys $tap-time $hold-time s lalt $left-hand-letters)
  d (tap-hold-except-keys $tap-time $hold-time d lctl $left-hand-letters)
  f (tap-hold-except-keys $tap-time $hold-time f lsft $left-hand-letters)

  ;; -- Right Hand Mods --
  ;; 'j' and 'k' can now be held together because they don't exclude each other.
  j (tap-hold-except-keys $tap-time $hold-time j rsft $right-hand-letters)
  k (tap-hold-except-keys $tap-time $hold-time k rctl $right-hand-letters)
  l (tap-hold-except-keys $tap-time $hold-time l ralt $right-hand-letters)
  scl (tap-hold-except-keys $tap-time $hold-time ; rmet $right-hand-letters)
)
